{
  "hosting": [
    {
      "target": "home",
      "public": "dist/home",
      "cleanUrls": true,
      "headers": [
        {
          "source": "**/*.@(js|css|html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/api/**",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        }
      ]
    },
    {
      "target": "student",
      "public": "dist/student",
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "teacher",
      "public": "dist/teacher",
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "hub",
      "public": "dist/oldhub",
      "redirects": [
        {
          "source": "/:path*",
          "destination": "https://flexihub.web.app/:path*",
          "type": 301
        }
      ]
    },
    {
      "target": "oldhub",
      "public": "dist/oldhub",
      "redirects": [
        {
          "source": "/:path*",
          "destination": "https://flexihub.web.app/:path*",
          "type": 301
        }
      ]
    },
    {
      "target": "oldhub2",
      "public": "dist/oldhub",
      "redirects": [
        {
          "source": "/:path*",
          "destination": "https://flexihub.web.app/:path*",
          "type": 301
        }
      ]
    },
    {
      "target": "banda",
      "public": "dist/oldhub",
      "redirects": [
        {
          "source": "/:path*",
          "destination": "https://world-islands.web.app/:path*",
          "type": 301
        }
      ]
    },
    {
      "target": "banda2",
      "public": "dist/oldhub",
      "redirects": [
        {
          "source": "/:path*",
          "destination": "https://world-islands.web.app/:path*",
          "type": 301
        }
      ]
    },
    {
      "target": "recoon",
      "public": "dist/oldhub",
      "redirects": [
        {
          "source": "/:path*",
          "destination": "https://flexihub.web.app/:path*",
          "type": 301
        }
      ]
    },
    {
      "target": "world",
      "public": "dist/banda",
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/.well-known/assetlinks.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "ignore": [
        "firebase.json",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/download/windows",
          "destination": "https://github.com/erdanthecoder/copilot/releases/download/windows-app/WorldIslands-Setup.exe",
          "type": 302
        },
        {
          "source": "/download/android",
          "destination": "https://github.com/erdanthecoder/copilot/releases/download/android-app/WorldIslands.apk",
          "type": 302
        }
      ]
    },
    {
      "target": "olive",
      "public": "dist/oldhub",
      "redirects": [
        {
          "source": "/:path*",
          "destination": "https://flexihub.web.app/:path*",
          "type": 301
        }
      ]
    },
    {
      "target": "flexi",
      "public": "dist/hub",
      "headers": [
        {
          "source": "**/*.@(js|css|html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ]
}
