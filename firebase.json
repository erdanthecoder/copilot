{
  "hosting": [
    {
      "target": "home",
      "public": "dist/home",
      "cleanUrls": true,
      "headers": [{ "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
    },
    {
      "target": "student",
      "public": "dist/student",
      "cleanUrls": true,
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [{ "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
    },
    {
      "target": "teacher",
      "public": "dist/teacher",
      "cleanUrls": true,
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [{ "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
    }
  ]
}
